# Copie para .env e troque TODOS os valores. Nunca commite o .env.
# Gere senhas e chaves com:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Ambiente: desenvolvimento (roda o seed) | producao
AMBIENTE=desenvolvimento

# --- Banco de dados -----------------------------------------------------------
# Dono do esquema: usado só pelas migrações (Alembic) e pelos scripts de backup.
POSTGRES_USER=simplemark_dono
POSTGRES_PASSWORD=troque-esta-senha-do-dono
POSTGRES_DB=simplemark
MIGRATION_DATABASE_URL=postgresql://simplemark_dono:troque-esta-senha-do-dono@db:5432/simplemark

# Usuário da API: só lê e grava dados (criado por banco/init/01-usuario-app.sh).
APP_DB_USER=simplemark_app
APP_DB_PASSWORD=troque-esta-senha-da-api
DATABASE_URL=postgresql://simplemark_app:troque-esta-senha-da-api@db:5432/simplemark

# Senha que criptografa os backups (scripts/banco/backup.sh)
BACKUP_SENHA=troque-esta-senha-do-backup

# --- Segurança ------------------------------------------------------------------
# Assina os tokens de login e os HMAC dos códigos enviados por e-mail.
SECRET_KEY=troque-esta-chave-secreta

# Origens autorizadas a acessar a API (sem caminho, separadas por vírgula).
CORS_ORIGENS=https://simplemark-frontend.onrender.com,http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Administradora inicial (criada no primeiro start). Troque a senha depois pela tela "Minha conta".
ADMIN_EMAIL=admin@example.com
ADMIN_SENHA=troque-esta-senha-do-admin
ADMIN_CPF=000.000.000-00

# Senha dos usuários de exemplo do seed (só em AMBIENTE=desenvolvimento)
SEED_SENHA=troque-esta-senha-do-seed

# --- Integrações ----------------------------------------------------------------
BASE_URL_VALIDACAO=http://localhost:8080/api/v1
JITSI_BASE_URL=https://meet.jit.si

# E-mail: "brevo" (API HTTP, use em produção) ou "smtp" (ex.: Mailpit local).
# Vazio: usa o Brevo se BREVO_API_KEY estiver preenchida; senão, o SMTP abaixo.
EMAIL_PROVEDOR=
# Chave da API (Brevo > SMTP & API > API Keys). Não é a senha SMTP do Brevo.
BREVO_API_KEY=
# Remetente validado no Brevo (Senders, Domains & Dedicated IPs)
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=SimpleMark

SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USAR_TLS=true
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_EMAIL=
SMTP_SENHA_APP=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_FRONTEND_URL=https://simplemark-frontend.onrender.com
PAGAMENTO_SIMULADO=false
